# MuleCatch local-development template. Never commit populated secrets.
ENV=development
AUTH_ENABLED=false

JWT_SECRET=change_me_before_deployment
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NOT_FOR_PRODUCTION
NEO4J_TLS_ENABLED=false

POSTGRES_USER=mulecatch
POSTGRES_PASSWORD=mulecatch_dev_2024
POSTGRES_URL=
REDIS_URL=redis://localhost:6379/0
CACHE_L1_MAX_SIZE=1000
CACHE_L1_TTL_SECONDS=60
CACHE_L2_TTL_SECONDS=600

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_UPI=mulecatch.transactions
KAFKA_GROUP_ID=mulecatch-detection-group
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=

MODEL_VERSION=unvalidated-dev
RULE_VERSION=rules-2026.1
GNN_MODEL_PATH=models/gnn/trained_model.pt

SMURF_FLAG_THRESHOLD=0.55
ONBOARDING_RISK_THRESHOLD=0.50

FEEDBACK_STORE_PATH=
FEEDBACK_FP_RAISE_BOUND=0.30
FEEDBACK_FP_LOWER_BOUND=0.10
FEEDBACK_RAISE_DELTA=0.05
FEEDBACK_LOWER_DELTA=-0.03
FEEDBACK_RECENT_WINDOW=20
FEEDBACK_MIN_FOR_ADJUSTMENT=5
FEEDBACK_RETRAIN_BATCH_SIZE=20

CORS_ORIGINS=["http://localhost:3000"]
SCREENING_ENABLED=false
UNSC_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
FRI_API_URL=

LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Live Bitcoin payment feed on the Live stream page (always on in demo mode)
LIVE_FEED_ENABLED=false

GENAI_ENABLED=false
GENAI_PROVIDER=gemini
GENAI_API_KEY=
GENAI_MODEL=
GENAI_TEMPERATURE=0.3
GENAI_MAX_TOKENS=2048
GENAI_TIMEOUT_SECONDS=30

REPORTING_ENTITY=Indian Overseas Bank
REPORTING_IFSC=IOBA0000001
FIU_FORMAT_VERSION=2.1
ANALYST_HOURLY_COST_INR=0
BENCHMARK_RESULTS_PATH=data/benchmark_results.json

# Development-only credentials. Never use these values in production.
DEMO_INVESTIGATOR_PASSWORD=iob@2024
DEMO_SUPERVISOR_PASSWORD=supervisor@2024
DEMO_ADMIN_PASSWORD=admin@2024

AUDIT_LOG_PATH=/app/logs/audit.jsonl
LOG_LEVEL=INFO

# Override rule thresholds with a JSON object naming only the values to change.
# Names and defaults: backend/detection/rule_thresholds.py. Unknown names stop startup.
# RULE_THRESHOLDS={"new_account_age_days": 14}
RULE_THRESHOLDS=
