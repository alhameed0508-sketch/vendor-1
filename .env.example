# MuleCatch Environment Configuration
# Copy to .env and fill in values before deployment

# ── Neo4j ──────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_before_deployment
# Enable TLS for Neo4j Bolt connections (requires certs)
NEO4J_TLS_ENABLED=false

# ── Kafka ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_ENABLED=false

# ── PostgreSQL (persistent storage for STRs, audit, KPIs) ────
# Leave empty to use in-memory repositories (demo/dev only)
POSTGRES_URL=postgresql://mulecatch:mulecatch_dev_2024@postgres:5432/mulecatch
POSTGRES_USER=mulecatch
POSTGRES_PASSWORD=mulecatch_dev_2024

# ── Redis / Cache ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_L1_MAX_SIZE=1000
CACHE_L1_TTL_SECONDS=60
CACHE_L2_TTL_SECONDS=600

# ── API ────────────────────────────────────────────────────────
JWT_SECRET=change_me_before_deployment
API_HOST=0.0.0.0
API_PORT=8000
# Set to "production" to enable production validation and disable demo mode
ENV=development
# Must be true in production
AUTH_ENABLED=false

# ── Token Expiry ──────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Account Lockout ──────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ── LDAP / Active Directory ──────────────────────────────────
LDAP_ENABLED=false
LDAP_URL=ldap://your-ad-server:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com

# ── Sanctions / PEP Screening ────────────────────────────────
SCREENING_ENABLED=false
UNSC_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml

# ── Detection thresholds ─────────────────────────────────────
SMURF_FLAG_THRESHOLD=0.55
CLUSTER_SUSPICION_THRESHOLD=0.50
MIN_CLUSTER_SIZE=3

# ── Compliance ───────────────────────────────────────────────
REPORTING_ENTITY=Indian Overseas Bank
REPORTING_IFSC=IOBA0000001
FIU_FORMAT_VERSION=2.1

# ── GenAI / LLM ─────────────────────────────────────────────
GENAI_ENABLED=false
# Provider: gemini (recommended — Indian data residency), openai, anthropic
GENAI_PROVIDER=gemini
GENAI_API_KEY=
# Model override (leave empty for provider default)
GENAI_MODEL=
GENAI_TEMPERATURE=0.3
GENAI_MAX_TOKENS=2048
GENAI_TIMEOUT_SECONDS=30

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://frontend:80"]

# ── Onboarding ───────────────────────────────────────────────
ONBOARDING_RISK_THRESHOLD=0.50

# ── GNN Model ────────────────────────────────────────────────
GNN_MODEL_PATH=models/gnn/trained_model.pt

# ── Demo Users (non-production only) ─────────────────────────
# These credentials are ONLY used when ENV != "production".
DEMO_INVESTIGATOR_PASSWORD=iob@2024
DEMO_SUPERVISOR_PASSWORD=supervisor@2024
DEMO_ADMIN_PASSWORD=admin@2024

# ── Logging ──────────────────────────────────────────────────
AUDIT_LOG_PATH=/app/logs/audit.jsonl
LOG_LEVEL=INFO
