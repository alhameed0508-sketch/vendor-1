# Netrava IntentLock settings. Copy to .env and fill in. Never commit real values.
APP_ENV=development
FRONTEND_URL=http://localhost:8000

# PostgreSQL is the source of truth. Leave empty only for a local run (a SQLite file is used and data is not durable).
DATABASE_URL=

# 32+ random characters. Signs the buyer session cookie.
SESSION_SECRET=
# Optional. Signs receipts; derived from SESSION_SECRET when empty.
RECEIPT_SIGNING_KEY=

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the PayPal developer dashboard after you add the webhook URL https://<your-host>/api/v1/paypal/webhooks
PAYPAL_WEBHOOK_ID=
# Optional. If set, an order whose payee is a different merchant is refused at creation.
PAYPAL_MERCHANT_ID=
PAYPAL_CURRENCY=USD

GENAI_ENABLED=true
GENAI_PROVIDER=gemini
GENAI_API_KEY=
GENAI_MODEL=gemini-3.1-flash-lite

# Optional: a receipt share link (copied from a receipt page) to show on the home page as "See a real receipt".
FEATURED_RECEIPT=

# Demo only: shows a button that changes the PayPal order behind the checkout (Scenario C). Keep false otherwise.
DEMO_TOOLS=false
