  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action per view, e.g. New purchase.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New purchase</button>",
      "css": ".ds-btn-primary{font-family:\"Source Sans 3\",system-ui,sans-serif;font-weight:600;font-size:.92rem;border-radius:5px;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);padding:7px 14px;cursor:pointer;display:inline-flex;gap:8px;align-items:center;white-space:nowrap}.ds-btn-primary:hover{background:color-mix(in oklab,var(--accent) 88%,black)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral action on paper.",
      "html": "<button class=\"ds-btn2\">Open receipt</button>",
      "css": ".ds-btn2{font-family:\"Source Sans 3\",system-ui,sans-serif;font-weight:600;font-size:.92rem;border-radius:5px;border:1px solid var(--rule-strong);background:var(--panel);color:var(--ink);padding:7px 14px;cursor:pointer}.ds-btn2:hover{border-color:var(--ink-2)}.ds-btn2:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field; error state switches to block ink and ground.",
      "html": "<label class=\"ds-lbl\">Budget (USD)<input class=\"ds-input\" type=\"text\" value=\"1,200.00\"></label>",
      "css": ".ds-lbl{font-family:\"Source Sans 3\",system-ui,sans-serif;font-size:.8rem;font-weight:600;color:var(--ink-2);display:block}.ds-input{display:block;margin-top:4px;width:240px;font:15px/1.5 \"Source Sans 3\",system-ui,sans-serif;color:var(--ink);background:var(--panel);border:1px solid var(--rule-strong);border-radius:5px;padding:8px 10px}.ds-input:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail",
      "description": "Bookcloth rail with group label and icon items.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-rail-group\">Monitor</div><a class=\"ds-nav on\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg>Dashboard</a><a class=\"ds-nav\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z\"/><path d=\"M5 17a3 3 0 0 1 3-3h11\"/><path d=\"M9 8h6\"/></svg>Ledger</a></nav>",
      "css": ".ds-rail{background:var(--cloth);color:var(--cloth-ink);width:236px;padding:8px 10px 16px;font-family:\"Source Sans 3\",system-ui,sans-serif;}.ds-rail-group{font-size:.72rem;font-weight:650;letter-spacing:.09em;text-transform:uppercase;color:var(--cloth-muted);padding:16px 10px 6px}.ds-nav{display:flex;gap:10px;align-items:center;padding:7px 10px;border-radius:5px;color:var(--cloth-ink);text-decoration:none;font-size:.93rem}.ds-nav svg{opacity:.8}.ds-nav:hover{background:var(--cloth-2)}.ds-nav.on{background:var(--cloth-2);box-shadow:inset 0 0 0 1px var(--cloth-line);font-weight:600}.ds-nav:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Outcome Badges",
      "kind": "chip",
      "refersTo": "badge-block",
      "description": "State tag: ink on tinted ground with a dot.",
      "html": "<span class=\"ds-badge ds-ok\">Paid</span> <span class=\"ds-badge ds-bad\">Refused</span> <span class=\"ds-badge ds-warn\">Needs approval</span> <span class=\"ds-badge ds-info\">Unverified</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;font-family:\"Source Sans 3\",system-ui,sans-serif;font-size:.76rem;font-weight:650;padding:2px 8px;border-radius:3px}.ds-badge::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.ds-ok{color:var(--allow);background:var(--allow-bg)}.ds-bad{color:var(--block);background:var(--block-bg)}.ds-warn{color:var(--reauth);background:var(--reauth-bg)}.ds-info{color:var(--review);background:var(--review-bg)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat sheet on a hairline seam.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-ph\"><h2>Integrity</h2><span>store-wide</span></div><p>Audit chain intact, 63 events.</p></section>",
      "css": ".ds-panel{background:var(--panel);border:1px solid var(--rule);border-radius:6px;padding:18px 20px;color:var(--ink);font-family:\"Source Sans 3\",system-ui,sans-serif;font-size:15px;max-width:360px}.ds-ph{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}.ds-ph h2{margin:0;font-size:.98rem;font-weight:650}.ds-ph span{font-size:.875rem;color:var(--muted)}.ds-panel p{margin:0}"
    },
    {
      "name": "Ledger Rows",
      "kind": "custom",
      "refersTo": "panel",
      "description": "One entry per proposal; refusals post in red with the rule as memo; total on a double rule.",
      "html": "<table class=\"ds-ledger\"><thead><tr><th>Ref</th><th>Memo</th><th class=\"ds-r\">Amount</th></tr></thead><tbody><tr><td class=\"ds-ref\">IL-0012</td><td><span class=\"ds-memo\">MAXIMUM_TOTAL</span></td><td class=\"ds-r ds-neg\">(986.00)</td></tr><tr><td class=\"ds-ref\">IL-0011</td><td>captured</td><td class=\"ds-r ds-cap\">1,972.00</td></tr></tbody><tfoot><tr><td colspan=\"2\">Captured</td><td class=\"ds-r\">1,972.00</td></tr></tfoot></table>",
      "css": ".ds-ledger{border-collapse:collapse;font-family:\"Source Sans 3\",system-ui,sans-serif;font-size:.9rem;color:var(--ink);font-variant-numeric:tabular-nums;min-width:380px}.ds-ledger th{text-align:left;font-weight:650;color:var(--muted);font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;padding:8px 10px;border-bottom:1px solid var(--rule-strong)}.ds-ledger td{padding:9px 10px;border-bottom:1px solid var(--rule)}.ds-ledger td+td,.ds-ledger th+th{border-left:1px solid color-mix(in oklab,var(--rule) 60%,transparent)}.ds-ledger tbody tr:hover{background:color-mix(in oklab,var(--accent-soft) 40%,transparent)}.ds-r{text-align:right}.ds-ref{font-family:\"Source Code Pro\",monospace;font-size:.82rem;color:var(--ink-2)}.ds-memo{font-family:\"Source Code Pro\",monospace;font-size:.78rem;color:var(--block)}.ds-neg{color:var(--block)}.ds-cap{color:var(--allow);font-weight:600}.ds-ledger tfoot td{border-top:1px solid var(--ink);border-bottom:3px double var(--ink);font-weight:650}"
    },
    {
      "name": "Segmented Period",
      "kind": "custom",
      "refersTo": "segmented-on",
      "description": "Period picker; pressed option inverts to ink.",
      "html": "<div class=\"ds-seg\"><button>7 days</button><button aria-pressed=\"true\">14 days</button><button>30 days</button></div>",
