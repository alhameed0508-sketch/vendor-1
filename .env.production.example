# MuleCatch Production Environment Configuration
# ================================================
# Copy to .env and replace ALL placeholder values before deployment.
# The production validator will reject default/weak secrets at startup.

# ── Neo4j ──────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# CHANGE THIS: Use a strong, unique password (min 16 chars)
NEO4J_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
NEO4J_TLS_ENABLED=true

# ── PostgreSQL ─────────────────────────────────────────────────
# CHANGE THIS: Use strong credentials
POSTGRES_URL=postgresql://mulecatch:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/mulecatch
POSTGRES_USER=mulecatch
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Kafka ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_ENABLED=true

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth (REQUIRED in production) ──────────────────────────────
# CHANGE THIS: Use a cryptographically random secret (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_SECRET
AUTH_ENABLED=true

# ── Application ────────────────────────────────────────────────
ENV=production
API_HOST=0.0.0.0
API_PORT=8000

# ── Token Expiry ───────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Account Lockout ────────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ── LDAP / Active Directory (optional) ─────────────────────────
LDAP_ENABLED=false
# LDAP_URL=ldap://your-ad-server:389
# LDAP_BIND_DN=cn=admin,dc=yourbank,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=ou=users,dc=yourbank,dc=com

# ── Sanctions / PEP Screening ─────────────────────────────────
SCREENING_ENABLED=true
UNSC_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml

# ── Detection thresholds ───────────────────────────────────────
SMURF_FLAG_THRESHOLD=0.55
ONBOARDING_RISK_THRESHOLD=0.50

# ── Compliance ─────────────────────────────────────────────────
REPORTING_ENTITY=Indian Overseas Bank
REPORTING_IFSC=IOBA0000001
FIU_FORMAT_VERSION=2.1

# ── GenAI / LLM (optional) ────────────────────────────────────
GENAI_ENABLED=false
# GENAI_PROVIDER=gemini
# GENAI_API_KEY=REPLACE_WITH_API_KEY
# GENAI_MODEL=

# ── CORS (restrict to your production domain) ─────────────────
CORS_ORIGINS=["https://mulecatch.yourdomain.com"]

# ── GNN Model ──────────────────────────────────────────────────
GNN_MODEL_PATH=models/gnn/trained_model.pt

# ── Logging ────────────────────────────────────────────────────
AUDIT_LOG_PATH=/app/logs/audit.jsonl
LOG_LEVEL=INFO
